{
  "name": "premium-basebot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp modular (Baileys) preparado para Termux/Android y Linux/VPS",
  "type": "module",
  "main": "bot/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bot/index.js",
    "dev": "node --watch bot/index.js",
    "setup": "node scripts/setup.js",
    "reset-session": "node scripts/reset-session.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "termux"
  ],
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "6.7.24",
    "dotenv": "^17.2.3",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sql.js": "^1.14.0"
  }
}
