# ───────────────────────────── BOT ─────────────────────────────
BOT_NAME=NombreBot
BOT_VERSION=1.0.0

# Prefijo de los comandos (.menu, .ping…)
PREFIX=.
# Opcional: prefijos adicionales separados por comas (PREFIXES=!,#,/)
PREFIXES=

# ──────────────────────────── OWNER ────────────────────────────
OWNER_NAME=Owner
# Solo dígitos, con código de país y sin "+"  (ej. 549XXXXXXXXXX)
OWNER_NUMBER=
# Opcional: owners adicionales separados por comas
OWNER_NUMBERS=

# public | private
BOT_MODE=public

# ──────────────────────────── LÍMITES ──────────────────────────
DEFAULT_LIMIT=10
PREMIUM_LIMIT=50

# ──────────────────────── XP Y ECONOMÍA ────────────────────────
XP_PER_MESSAGE=5
XP_COOLDOWN=60
DAILY_XP=150
CURRENCY_NAME=monedas
CURRENCY_SYMBOL=🪙
DAILY_REWARD=500
START_BALANCE=100

# ──────────────────────────── STICKERS ─────────────────────────
STICKER_PACK=
STICKER_AUTHOR=

# ──────────────────────────── CONEXIÓN ─────────────────────────
# true = Pairing Code (recomendado en Termux) · false = código QR
USE_PAIRING_CODE=true
# Opcional: si lo rellenas no se pedirá el número por consola
PAIRING_NUMBER=
SESSION_DIR=sessions
MAX_RECONNECT_ATTEMPTS=10
BROWSER_NAME=Chrome

# ─────────────────────────── MULTIMEDIA ────────────────────────
MAX_MEDIA_MB=60
MAX_AUDIO_SECONDS=600
TEMP_TTL_MINUTES=30
BANNER_PATH=assets/banner.jpg

# ────────────────────────── COMPORTAMIENTO ─────────────────────
AUTO_READ=false
AUTO_TYPING=false
SELF_REPLY=true
REACT_ON_COMMAND=true
ANTISPAM_SECONDS=2

# ─────────────────────── APIS EXTERNAS (opcionales) ────────────
# IA (texto, imágenes y voz)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Clima (si falta, se usa Open-Meteo sin clave)
WEATHER_API_KEY=

# Imágenes
REMOVE_BG_API_KEY=

# Búsquedas
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
YOUTUBE_API_KEY=

# Stalk
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_API_KEY=
GITHUB_TOKEN=

# Música (solo metadatos)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Traducción (instancia de LibreTranslate)
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Emoji Kitchen (API oficial de Tenor)
TENOR_API_KEY=

# ────────────────────────────── VARIOS ─────────────────────────
SUPPORT_LINK=
HTTP_TIMEOUT_MS=20000
LOG_LEVEL=info
# BAILEYS_LOG_LEVEL=silent
NODE_ENV=production
